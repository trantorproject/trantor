root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120
ij_continuation_indent_size = 4

ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

# class Foo: Bar, not class Foo : Bar
ij_kotlin_space_before_extend_colon = false
ij_kotlin_space_after_extend_colon = true

# val foo: String, not val foo : String
ij_kotlin_space_before_type_colon = false
ij_kotlin_space_after_type_colon = true

# Trailing commas are used throughout; keeping them means one-line diffs when a parameter is added
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Imports are explicit until five names from the same package
ij_kotlin_name_count_to_use_star_import = 5
ij_kotlin_name_count_to_use_star_import_for_members = 5
ij_kotlin_packages_to_use_import_on_demand = java.util.*,kotlinx.android.synthetic.**
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
ij_kotlin_import_nested_classes = false

ij_kotlin_keep_blank_lines_in_code = 1
ij_kotlin_keep_blank_lines_before_right_brace = 0
ij_kotlin_keep_blank_lines_in_declarations = 1
ij_kotlin_blank_lines_after_class_header = 0
ij_kotlin_insert_whitespaces_in_simple_one_line_method = true

ij_kotlin_method_parameters_wrap = on_every_item
ij_kotlin_call_parameters_wrap = on_every_item
ij_kotlin_extends_list_wrap = normal

[*.{json,yml,yaml}]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab

[*.{bat,cmd}]
indent_style = space
indent_size = 4
